# ─────────────────────────────────────────────────────────────────────────────
#  ERSS Dubai — backend configuration
#  Copy to `.env` beside this file. Loaded natively by Node (--env-file-if-exists),
#  so it works identically under `npm run dev`, pm2 and systemd.
#  Real environment variables always win over this file.
#  NOTHING in here is ever sent to the client. No secret belongs in web/.env.
# ─────────────────────────────────────────────────────────────────────────────

# ── Process ──────────────────────────────────────────────────────────────────
PORT=4327
NODE_ENV=development
LOG_LEVEL=info

# Comma-separated allow-list. Never `*` in production — cookie sessions require a
# specific origin plus Access-Control-Allow-Credentials, which `*` cannot satisfy.
# Add your LAN origin here when testing on a phone, e.g. https://192.168.1.10:3327
CORS_ORIGINS=http://localhost:3327,https://localhost:3327

# ── Database (PostgreSQL 16 + PostGIS) ───────────────────────────────────────
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=erss_db
DB_USER=erss
DB_PASSWORD=
DB_POOL_MAX=10
DB_SSL=false

# ── Auth ─────────────────────────────────────────────────────────────────────
# 32+ random bytes. Generate: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET=
SESSION_HOURS=12
BCRYPT_ROUNDS=12
# Salt for Emirates ID hashing. PDPL: the raw ID is never stored.
EID_HASH_SALT=

# ── Routing ──────────────────────────────────────────────────────────────────
# Public demo instance is rate-limited. Self-host for any demo that matters —
# see docs/12-DEPLOYMENT.md §7.
OSRM_URL=https://router.project-osrm.org

# ── Seed ─────────────────────────────────────────────────────────────────────
# Fixed RNG seed: the generated history is deterministic and reproducible.
SEED_RNG=erss-dubai-2026
SEED_MONTHS=24

# ── Optional: assistant LLM seam ─────────────────────────────────────────────
# Leave blank. With no provider the assistant answers from rules and NOTHING else
# in the product changes — the Concept Note's "no external model calls" promise is
# literally true when these are empty.
# LLM_PROVIDER=  groq | gemini | openrouter | ollama | anthropic
LLM_PROVIDER=
LLM_API_KEY=
LLM_MODEL=
LLM_BASE_URL=

# ── Optional: integration seams ──────────────────────────────────────────────
# Absent = the documented mock is used, and the UI shows a "simulated source" chip.
MAKANI_API_KEY=
MAKANI_BASE_URL=
NABIDH_BASE_URL=
NABIDH_CLIENT_ID=
NABIDH_CLIENT_SECRET=
FCM_SERVER_KEY=
