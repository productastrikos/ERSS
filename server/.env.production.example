# ─────────────────────────────────────────────────────────────────────────────
#  ERSS Dubai — backend, PRODUCTION template   (deployment_context.md §5, §9)
#
#  COPY THIS TO `server/.env` ON THE SERVER and fill the four blanks. The process
#  loads `.env` and only `.env` (`node --env-file-if-exists=.env index.js`), so a
#  file called `.env.production` would be read by nobody.
#
#  Real environment variables win over this file, which is why pm2 passes PORT
#  inline (deployment_context.md §5) and why the value below is only the default.
#
#  Nothing here is ever sent to the client. No secret belongs in web/.env*.
# ─────────────────────────────────────────────────────────────────────────────

# ── Process ──────────────────────────────────────────────────────────────────
PORT=4327
NODE_ENV=production
LOG_LEVEL=info

# The frontend origin, exactly as the browser sends it — scheme, host AND port.
# Never `*`: cookie sessions need a specific origin plus Allow-Credentials, which a
# wildcard cannot satisfy, and config/env.js refuses to start on `*` in production.
CORS_ORIGINS=https://erss.astrikos.xyz:8443

# ── Database (PostgreSQL 16 + PostGIS) ───────────────────────────────────────
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=erss_db
DB_USER=erss
DB_PASSWORD=
DB_POOL_MAX=10
DB_SSL=false

# ── Auth ─────────────────────────────────────────────────────────────────────
# REQUIRED in production — the server refuses to boot without them (config/env.js
# validateEnv). Generate each:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET=
SESSION_HOURS=12
BCRYPT_ROUNDS=12
# Salt for Emirates ID hashing. PDPL: the raw ID is never stored.
EID_HASH_SALT=

# ── Routing ──────────────────────────────────────────────────────────────────
# The public OSRM demo instance is rate-limited and will stall a live demonstration
# over a hotel network. Self-host and point this at it (docs/12 §7).
OSRM_URL=https://router.project-osrm.org

# ── Seed ─────────────────────────────────────────────────────────────────────
# Fixed RNG seed: the generated history is deterministic and reproducible.
SEED_RNG=erss-dubai-2026
SEED_MONTHS=24

# ── Optional: assistant LLM seam ─────────────────────────────────────────────
# Leave blank. With no provider the assistant answers from rules and NOTHING else
# in the product changes — the Concept Note's "no external model calls" promise is
# literally true when these are empty.
LLM_PROVIDER=
LLM_API_KEY=
LLM_MODEL=
LLM_BASE_URL=

# ── Optional: integration seams ──────────────────────────────────────────────
# Absent = the documented mock is used, and the UI shows a "simulated source" chip.
MAKANI_API_KEY=
MAKANI_BASE_URL=
NABIDH_BASE_URL=
NABIDH_CLIENT_ID=
NABIDH_CLIENT_SECRET=
FCM_SERVER_KEY=
