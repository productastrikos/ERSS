{
  "name": "@erss/web",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "ERSS Dubai frontend — one bundle, two surfaces: / console, /app mobile",
  "scripts": {
    "dev": "vite --port 3327 --strictPort",
    "dev:lan": "vite --host --port 3327 --strictPort --mode lan",
    "build": "tsc -b && vite build",
    "preview": "vite preview --port 3327 --strictPort",
    "lint": "eslint .",
    "typecheck": "tsc -b --noEmit",
    "cap:sync": "npm run build && cap sync android",
    "cap:apk": "npm run cap:sync && cd android && gradlew.bat assembleDebug"
  },
  "dependencies": {
    "@deck.gl/aggregation-layers": "^9.2.11",
    "@deck.gl/core": "^9.2.11",
    "@deck.gl/extensions": "^9.2.11",
    "@deck.gl/geo-layers": "^9.2.11",
    "@deck.gl/layers": "^9.2.11",
    "@deck.gl/mapbox": "^9.2.11",
    "@deck.gl/mesh-layers": "^9.2.11",
    "@deck.gl/react": "^9.2.11",
    "lucide-react": "^0.548.0",
    "maplibre-gl": "^5.19.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "socket.io-client": "^4.8.3",
    "three": "^0.183.2"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@types/node": "^24.10.1",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@types/three": "^0.183.1",
    "@vitejs/plugin-basic-ssl": "^2.1.0",
    "@vitejs/plugin-react": "^5.1.1",
    "eslint": "^9.39.1",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "globals": "^16.5.0",
    "sass": "^1.97.3",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.48.0",
    "vite": "^7.3.1"
  }
}
