# ─────────────────────────────────────────────────────────────────────────────
#  ERSS Dubai — frontend, PRODUCTION build (deployment_context.md §5)
#
#  Vite reads this for `npm run build`. Every value here is baked into the bundle,
#  so NOTHING secret belongs in this file — it is served to the browser.
#
#  One backend: REST and the websocket share a host, a port and a single nginx
#  block (astriverse.conf, server_name erss-api.astrikos.xyz). The two variables
#  below are therefore the same URL, and both must be set — lib/config.ts and
#  lib/api.ts report a missing value as missing rather than falling back to a host
#  that happens to work on one machine.
# ─────────────────────────────────────────────────────────────────────────────

VITE_API_URL=https://erss-api.astrikos.xyz:8443
VITE_SOCKET_URL=https://erss-api.astrikos.xyz:8443

# Routing. The public OSRM demo server is rate-limited — self-host for any demo that
# matters (docs/12 §7) and point this at it.
VITE_OSRM_URL=https://router.project-osrm.org

# Basemaps, per theme. The light style falls back to the dark one when unset.
VITE_MAP_STYLE=https://basemaps.cartocdn.com/gl/dark-matter-gl-style/style.json
VITE_MAP_STYLE_LIGHT=https://basemaps.cartocdn.com/gl/positron-gl-style/style.json

# More basemaps — the Layers panel's "Base map" picker and the live map's Satellite button.
# Each option is hidden when its variable is unset.
# "Streets": a full-colour street map, the same in both themes.
VITE_MAP_STYLE_STREETS=https://basemaps.cartocdn.com/gl/voyager-gl-style/style.json
# "Satellite": XYZ raster imagery ({z}/{x}/{y} in any order), drawn under the map's labels
# and 3D buildings. Esri World Imagery is fine for the trial; production use needs an
# ArcGIS account/key or another licensed imagery source — swap the template here.
VITE_MAP_SATELLITE_TILES=https://server.arcgisonline.com/ArcGIS/rest/services/World_Imagery/MapServer/tile/{z}/{y}/{x}
VITE_MAP_SATELLITE_ATTRIBUTION=Imagery © Esri, Maxar, Earthstar Geographics
