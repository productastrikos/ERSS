# Dev: Vite proxies /api and /socket.io to the backend, so the browser sees ONE origin
# and cookies/CORS behave exactly as they do behind nginx in production.
VITE_API_URL=
VITE_SOCKET_URL=
VITE_OSRM_URL=https://router.project-osrm.org
VITE_MAP_STYLE=https://basemaps.cartocdn.com/gl/dark-matter-gl-style/style.json
# Light-theme basemap. Falls back to VITE_MAP_STYLE when unset.
VITE_MAP_STYLE_LIGHT=https://basemaps.cartocdn.com/gl/positron-gl-style/style.json
